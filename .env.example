# Copy to .env (or export in your shell). If you've run `ant auth login`, you can skip the key.
ANTHROPIC_API_KEY=
# Optional overrides
JOBOS_MODEL=claude-opus-5-5
JOBOS_DB=data/jobos.db

# Optional split: OpenAI writes (resume wording, resume chat, messages), Claude does the technical work
# (LaTeX, one-page fit, reading pages, fit checks). Leave JOBOS_WRITER unset to use Claude for everything.
# JOBOS_WRITER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
